# Suggestion features (Suggest a path / Propose a workflow) need one LLM
# provider configured. These are plain env vars, NOT VITE_-prefixed -- they
# stay server-side (read by vite.config.js) and are never bundled into the
# client JS. Set exactly one, or set more than one and use LLM_PROVIDER to
# pick which one wins.

# Option 1: Anthropic -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Option 2: OpenAI -- https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# Option 3: OpenRouter -- https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-5

# If more than one key above is set, this forces which one is used --
# "anthropic" | "openai" | "openrouter". Otherwise Anthropic wins first,
# then OpenAI, then OpenRouter.
# LLM_PROVIDER=
